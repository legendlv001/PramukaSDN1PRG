                                <option value="C" ${s.nilai === 'C' ? 'selected' : ''}>C (Cukup)</option>
                                <option value="D" ${s.nilai === 'D' ? 'selected' : ''}>D (Kurang)</option>
                                <option value="E" ${s.nilai === 'E' ? 'selected' : ''}>E (Sangat Kurang)</option>
                            </select>
                        </td>
                    </tr>
                `;
            });

            document.getElementById('section-tabel-nilai').classList.remove('hidden');
        }

        function updateNilaiSiswa(id, val) {
            if(userRole === 'tamu') return;
            const s = siswaList.find(item => item.id === id);
            if(s) {
                s.nilai = val;
            }
        }

        function simpanDataNilai() {
            if(userRole === 'tamu') {
                showToast('Mode Tamu tidak diizinkan menyimpan perubahan.', 'warning');
                return;
            }

            const materi = document.getElementById('display-nama-materi').textContent;
            const filteredSiswa = getFilteredSiswaList();
            
            let exportRows = [`Materi\tNama Siswa\tKelas\tRegu\tNilai`];
            let payloadRows = [];

            filteredSiswa.forEach(s => {
                if(!s.riwayatNilai) s.riwayatNilai = {};
                s.riwayatNilai[materi] = s.nilai || 'A';
                
                let grades = Object.values(s.riwayatNilai);
                s.nilai = calculateAverageGrade(grades);

                exportRows.push(`${materi}\t${s.nama}\t${s.kelas}\t${s.regu}\t${s.riwayatNilai[materi]}`);
                payloadRows.push({
                    sheet: 'Nilai',
                    values: [materi, s.nama, s.kelas, s.regu, s.riwayatNilai[materi]]
                });

                payloadRows.push({
                    sheet: 'Rekap Nilai',
                    values: [s.nama, s.kelas, s.regu, s.nilai]
                });
            });

            localStorage.setItem('pramuka_app_siswa', JSON.stringify(siswaList));
            renderRekapNilai();

            if(appsScriptUrl) {
                sendDataToAppsScript(payloadRows, `Nilai materi "${materi}" & rekap rata-rata berhasil dikirim otomatis ke Spreadsheet!`);
            } else {
                showToast(`Nilai materi "${materi}" berhasil disimpan!`);
                showExportModal(exportRows.join('\n'));
            }
        }

        async function sendDataToAppsScript(rowsData, successMessage) {
            showToast('Mengirim data langsung ke Google Spreadsheet...', 'info');
            try {
                for(let item of rowsData) {
                    await fetch(appsScriptUrl, {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(item)
                    });
                }
                showToast(successMessage);
            } catch (err) {
                console.error(err);
                showToast('Gagal mengirim otomatis, silakan salin manual via modal.', 'error');
            }
        }

        function saveAppsScriptUrl() {
            const val = document.getElementById('input-apps-script-url').value.trim();
            appsScriptUrl = val;
            localStorage.setItem('pramuka_apps_script_url', val);
            showToast('URL Google Apps Script berhasil disimpan!');
        }

        function showExportModal(textData) {
            document.getElementById('export-textarea').value = textData;
            const modal = document.getElementById('export-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeExportModal() {
            const modal = document.getElementById('export-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function copyExportText() {
            const textarea = document.getElementById('export-textarea');
            textarea.select();
            document.execCommand('copy');
            showToast('Data berhasil disalin ke clipboard!');
            closeExportModal();
        }

        window.addEventListener('DOMContentLoaded', async () => {
            userRole = 'tamu';
            localStorage.setItem('pramuka_user_role', 'tamu');
            checkRole();
            await loadAllData(true);
        });

        window.addEventListener('online', () => {
            loadAllData(true);
            showToast('Koneksi internet kembali. Menyinkronkan data...', 'info');
        });
    </script>
</body>
</html>