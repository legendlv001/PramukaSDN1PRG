<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pramuka SD Negeri 1 Parigi</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pramuka: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#15803d',
                            700: '#166534',
                            800: '#14532d',
                            900: '#0f3d20',
                        }
                    },
                    keyframes: {
                        wave: {
                            '0%, 100%': { transform: 'rotate(0deg)' },
                            '25%': { transform: 'rotate(20deg)' },
                            '75%': { transform: 'rotate(-20deg)' },
                        }
                    },
                    animation: {
                        wave: 'wave 1.5s infinite ease-in-out',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex flex-col">

    <header class="bg-pramuka-700 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <!-- Brand Logo & Title -->
            <div onclick="switchTab('dashboard')" class="flex items-center space-x-3 cursor-pointer group">
                <div class="bg-white text-pramuka-700 p-2 rounded-xl shadow-inner group-hover:scale-105 transition duration-200">
                    <i class="fa-solid fa-tent text-xl"></i>
                </div>
                <div>
                    <h1 class="text-base md:text-lg font-bold tracking-wide group-hover:underline">Pramuka SD Negeri 1 Parigi</h1>
                </div>
            </div>
            
            <!-- Mobile Menu Toggle Button -->
            <div class="flex items-center space-x-2 md:hidden">
                <button id="mobile-menu-btn" class="text-white p-2.5 rounded-lg hover:bg-pramuka-800 focus:outline-none transition">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>

            <!-- Desktop Navigation Links -->
            <nav id="desktop-nav" class="hidden md:flex items-center space-x-1">
                <button onclick="switchTab('dashboard')" id="nav-btn-dashboard" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium hover:bg-pramuka-600 transition flex items-center space-x-2 bg-pramuka-800">
                    <i class="fa-solid fa-house"></i> <span>Dashboard</span>
                </button>
                <button onclick="switchTab('siswa')" id="nav-btn-siswa" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium hover:bg-pramuka-600 transition flex items-center space-x-2">
                    <i class="fa-solid fa-users"></i> <span>Data Siswa</span>
                </button>
                <button onclick="switchTab('absen')" id="nav-btn-absen" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium hover:bg-pramuka-600 transition flex items-center space-x-2 nav-pembina-only">
                    <i class="fa-solid fa-clipboard-user"></i> <span>Absen Pramuka</span>
                </button>
                <button onclick="switchTab('nilai')" id="nav-btn-nilai" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium hover:bg-pramuka-600 transition flex items-center space-x-2 nav-pembina-only">
                    <i class="fa-solid fa-award"></i> <span>Penilaian Materi</span>
                </button>
                <button onclick="switchTab('rekap')" id="nav-btn-rekap" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium hover:bg-pramuka-600 transition flex items-center space-x-2">
                    <i class="fa-solid fa-chart-pie"></i> <span>Rekap Kehadiran</span>
                </button>
                <button onclick="switchTab('rekap-nilai')" id="nav-btn-rekap-nilai" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium hover:bg-pramuka-600 transition flex items-center space-x-2">
                    <i class="fa-solid fa-chart-line"></i> <span>Rekap Nilai</span>
                </button>
                <button onclick="switchTab('hasil')" id="nav-btn-hasil" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium hover:bg-pramuka-600 transition flex items-center space-x-2">
                    <i class="fa-solid fa-square-poll-vertical"></i> <span>Hasil</span>
                </button>
                <button onclick="switchTab('settings')" id="nav-btn-settings" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium hover:bg-pramuka-600 transition flex items-center space-x-2 nav-pembina-only">
                    <i class="fa-solid fa-gear"></i> <span>Pengaturan Pembina</span>
                </button>
                
                <!-- Desktop Auth / Login Pembina Button -->
                <button id="desktop-auth-btn" onclick="handleAuthClick()" class="ml-2 bg-amber-500 hover:bg-amber-600 text-gray-900 px-2 py-1.5 rounded-lg text-xs font-bold shadow-sm transition flex items-center space-x-1.5 active:scale-95">
                    <i id="desktop-auth-icon" class="fa-solid fa-right-to-bracket text-xs"></i>
                    <span id="desktop-btn-mode-text">Login Pembina</span>
                </button>
            </nav>
        </div>

        <!-- Mobile Dropdown Menu -->
        <div id="mobile-menu" class="hidden bg-pramuka-800 border-t border-pramuka-600 px-4 pt-2 pb-4 space-y-1 shadow-lg md:hidden">
            <div class="space-y-1 border-b border-pramuka-600 pb-2 mb-2">
                <button onclick="switchTab('dashboard'); toggleMobileMenu()" class="w-full text-left px-3 py-2.5 rounded-lg text-base font-medium hover:bg-pramuka-700 flex items-center space-x-3">
                    <i class="fa-solid fa-house w-6"></i> <span>Dashboard</span>
                </button>
                <button onclick="switchTab('siswa'); toggleMobileMenu()" class="w-full text-left px-3 py-2.5 rounded-lg text-base font-medium hover:bg-pramuka-700 flex items-center space-x-3">
                    <i class="fa-solid fa-users w-6"></i> <span>Data Siswa</span>
                </button>
                <button onclick="switchTab('absen'); toggleMobileMenu()" class="w-full text-left px-3 py-2.5 rounded-lg text-base font-medium hover:bg-pramuka-700 flex items-center space-x-3 nav-pembina-only">
                    <i class="fa-solid fa-clipboard-user w-6"></i> <span>Absen Pramuka</span>
                </button>
                <button onclick="switchTab('nilai'); toggleMobileMenu()" class="w-full text-left px-3 py-2.5 rounded-lg text-base font-medium hover:bg-pramuka-700 flex items-center space-x-3 nav-pembina-only">
                    <i class="fa-solid fa-award w-6"></i> <span>Penilaian Materi</span>
                </button>
                <button onclick="switchTab('rekap'); toggleMobileMenu()" class="w-full text-left px-3 py-2.5 rounded-lg text-base font-medium hover:bg-pramuka-700 flex items-center space-x-3">
                    <i class="fa-solid fa-chart-pie w-6"></i> <span>Rekap Kehadiran</span>
                </button>
                <button onclick="switchTab('rekap-nilai'); toggleMobileMenu()" class="w-full text-left px-3 py-2.5 rounded-lg text-base font-medium hover:bg-pramuka-700 flex items-center space-x-3">
                    <i class="fa-solid fa-chart-line w-6"></i> <span>Rekap Nilai</span>
                </button>
                <button onclick="switchTab('hasil'); toggleMobileMenu()" class="w-full text-left px-3 py-2.5 rounded-lg text-base font-medium hover:bg-pramuka-700 flex items-center space-x-3">
                    <i class="fa-solid fa-square-poll-vertical w-6"></i> <span>Hasil</span>
                </button>
                <button onclick="switchTab('settings'); toggleMobileMenu()" class="w-full text-left px-3 py-2.5 rounded-lg text-base font-medium hover:bg-pramuka-700 flex items-center space-x-3 nav-pembina-only">
                    <i class="fa-solid fa-gear w-6"></i> <span>Pengaturan Pembina</span>
                </button>
            </div>
            <!-- Mobile Auth Button -->
            <button id="auth-action-btn" onclick="handleAuthClick(); toggleMobileMenu()" class="w-full text-left px-2.5 py-2 rounded-lg text-xs font-semibold bg-amber-500 text-gray-900 hover:bg-amber-600 flex items-center space-x-2 transition">
                <i id="auth-icon" class="fa-solid fa-right-to-bracket w-4 text-xs"></i>
                <span id="btn-mode-text">Login Pembina</span>
            </button>
        </div>
    </header>

    <div id="login-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl w-full max-w-sm shadow-2xl overflow-hidden p-6 text-center space-y-4 animate-fade-in">
            <div class="bg-pramuka-100 text-pramuka-700 w-16 h-16 rounded-full flex items-center justify-center mx-auto text-2xl shadow-inner">
                <i class="fa-solid fa-lock"></i>
            </div>
            <h3 id="login-modal-title" class="font-bold text-xl text-gray-800">Login Pembina</h3>
            <p id="login-modal-desc" class="text-xs text-gray-500">Masukkan password khusus pembina untuk mengakses fitur ubah dan simpan data.</p>
            
            <div class="space-y-3 pt-2">
                <input type="password" id="input-password" placeholder="Masukkan Password" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-pramuka-600 text-sm text-center font-bold tracking-widest">
                <button onclick="verifyLogin()" class="w-full bg-pramuka-700 hover:bg-pramuka-800 text-white py-3 rounded-xl font-bold shadow transition flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>Masuk</span>
                </button>
                <button onclick="closeLoginModal()" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 py-2.5 rounded-xl font-semibold transition text-xs">
                    Batal
                </button>
            </div>
        </div>
    </div>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-6">

        <!-- DASHBOARD TAB -->
        <section id="tab-dashboard" class="tab-content space-y-6">
            <!-- Welcome Banner -->
            <div class="bg-gradient-to-r from-pramuka-700 to-pramuka-800 text-white p-6 sm:p-8 rounded-2xl shadow-md relative overflow-hidden flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="space-y-2 z-10 text-center md:text-left">
                    <span class="inline-block bg-white/20 text-pramuka-50 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-1">
                        <i class="fa-solid fa-star text-amber-300 mr-1"></i> Salam Pramuka!
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight flex items-center justify-center md:justify-start gap-2">
                        <span>Selamat Datang</span> <span class="inline-block animate-wave text-3xl">👋</span>
                    </h2>
                    <p class="text-pramuka-100 text-sm sm:text-base max-w-xl">
                        Gerakan Pramuka Gugus Depan SD Negeri 1 Parigi. Bersama membentuk generasi muda yang berkarakter, mandiri, dan berjiwa Pancasila.
                    </p>
                </div>
                <div class="bg-white/10 p-5 rounded-2xl backdrop-blur-sm border border-white/10 z-10 text-center flex flex-col items-center justify-center min-w-[160px]">
                    <span id="current-greeting" class="text-sm font-bold">Halo, Kakak/Adik!</span>
                    <span class="text-xs text-pramuka-100">Tetap Semangat & Produktif</span>
                </div>
                <!-- Background silhouette decoration -->
                <div class="absolute -right-10 -bottom-10 opacity-10 text-9xl pointer-events-none">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center space-x-4">
                    <div class="bg-pramuka-100 text-pramuka-700 p-4 rounded-2xl text-2xl">
                        <i class="fa-solid fa-child-reaching"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Total Siswa Aktif</p>
                        <h3 id="stat-total-siswa" class="text-3xl font-bold text-gray-800">0</h3>
                    </div>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center space-x-4">
                    <div class="bg-green-100 text-green-700 p-4 rounded-2xl text-2xl">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Total Pertemuan Pramuka</p>
                        <h3 id="stat-pertemuan" class="text-3xl font-bold text-gray-800">0</h3>
                    </div>
                </div>
            </div>

            <!-- Quick Navigation Cards -->
            <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
                <h3 class="text-base font-bold text-gray-800 mb-4">Menu Pintas</h3>
                <div id="quick-menu-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    <button onclick="switchTab('siswa')" class="p-4 bg-pramuka-50 hover:bg-pramuka-100 text-pramuka-800 rounded-xl flex items-center justify-center space-x-2 font-medium transition active:scale-95">
                        <i class="fa-solid fa-users text-lg"></i>
                        <span>Data Siswa</span>
                    </button>
                    <button onclick="switchTab('absen')" class="quick-pembina-only p-4 bg-pramuka-50 hover:bg-pramuka-100 text-pramuka-800 rounded-xl flex items-center justify-center space-x-2 font-medium transition active:scale-95">
                        <i class="fa-solid fa-clipboard-user text-lg"></i>
                        <span>Absen Pramuka</span>
                    </button>
                    <button onclick="switchTab('nilai')" class="quick-pembina-only p-4 bg-pramuka-50 hover:bg-pramuka-100 text-pramuka-800 rounded-xl flex items-center justify-center space-x-2 font-medium transition active:scale-95">
                        <i class="fa-solid fa-award text-lg"></i>
                        <span>Penilaian Materi</span>
                    </button>
                    <button onclick="switchTab('rekap')" class="p-4 bg-pramuka-50 hover:bg-pramuka-100 text-pramuka-800 rounded-xl flex items-center justify-center space-x-2 font-medium transition active:scale-95">
                        <i class="fa-solid fa-chart-pie text-lg"></i>
                        <span>Rekap Kehadiran</span>
                    </button>
                    <button onclick="switchTab('rekap-nilai')" class="p-4 bg-pramuka-50 hover:bg-pramuka-100 text-pramuka-800 rounded-xl flex items-center justify-center space-x-2 font-medium transition active:scale-95">
                        <i class="fa-solid fa-chart-line text-lg"></i>
                        <span>Rekap Nilai</span>
                    </button>
                    <button onclick="switchTab('hasil')" class="p-4 bg-pramuka-50 hover:bg-pramuka-100 text-pramuka-800 rounded-xl flex items-center justify-center space-x-2 font-medium transition active:scale-95">
                        <i class="fa-solid fa-square-poll-vertical text-lg"></i>
                        <span>Hasil</span>
                    </button>
                    <!-- Tombol Masuk Group WhatsApp -->
                    <a href="https://chat.whatsapp.com/IdzSApCpsbD3u9jzeb7uue?s=cl&p=a&mlu=4" target="_blank" class="p-4 bg-green-50 hover:bg-green-100 text-green-700 rounded-xl flex items-center justify-center space-x-2 font-medium transition active:scale-95 col-span-1 sm:col-span-2 md:col-span-3 border border-green-200">
                        <i class="fa-brands fa-whatsapp text-xl text-green-600"></i>
                        <span>Gabung Grup WhatsApp Pramuka</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- DATA SISWA TAB -->
        <section id="tab-siswa" class="tab-content hidden space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h2 class="text-xl font-bold text-gray-800">Data Anggota Pramuka</h2>
                    <p class="text-sm text-gray-500">Menampilkan siswa sesuai kelas aktif yang dicentang di pengaturan.</p>
                </div>
            </div>

            <!-- Search -->
            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" id="search-siswa" oninput="renderSiswa()" placeholder="Cari nama siswa..." class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-pramuka-600 text-sm">
                </div>
            </div>

            <!-- Table -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-100 text-gray-600 text-xs uppercase tracking-wider">
                                <th class="p-4 font-semibold">No</th>
                                <th class="p-4 font-semibold">Nama Siswa</th>
                                <th class="p-4 font-semibold text-center">Kelas</th>
                                <th class="p-4 font-semibold text-center">Regu</th>
                            </tr>
                        </thead>
                        <tbody id="siswa-table-body" class="divide-y divide-gray-100 text-sm">
                            <!-- JS Generated -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ABSENSI TAB -->
        <section id="tab-absen" class="tab-content hidden space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 space-y-4">
                <div>
                    <h2 class="text-xl font-bold text-gray-800">Absen Pramuka</h2>
                    <p class="text-sm text-gray-500">Pilih tanggal kegiatan latihan terlebih dahulu untuk menampilkan daftar absensi.</p>
                </div>
                <div class="flex flex-col md:flex-row gap-3">
                    <input type="date" id="tanggal-sabtu" class="flex-grow px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-pramuka-600 text-sm font-bold text-pramuka-700">
                    <button onclick="mulaiAbsen()" class="bg-pramuka-700 hover:bg-pramuka-800 text-white px-6 py-3 rounded-xl font-medium shadow-sm transition flex items-center justify-center space-x-2 active:scale-95">
                        <i class="fa-solid fa-play"></i>
                        <span>Mulai Absen</span>
                    </button>
                </div>
            </div>

            <div id="section-tabel-absen" class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hidden">
                <div class="p-6 bg-pramuka-50 border-b border-gray-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <span class="text-xs font-bold uppercase text-gray-500 block">Tanggal Kegiatan:</span>
                        <h3 id="display-tanggal-absen" class="text-lg font-bold text-pramuka-800"></h3>
                    </div>
                    <div class="flex items-center gap-3 bg-white px-4 py-2.5 rounded-xl border border-gray-200 shadow-sm text-xs sm:text-sm font-semibold text-gray-700">
                        <span class="text-green-600"><i class="fa-solid fa-user-check mr-1"></i> Hadir: <strong id="count-hadir">0</strong></span>
                        <span class="text-amber-600"><i class="fa-solid fa-user-clock mr-1"></i> Sakit/Izin: <strong id="count-sakit">0</strong></span>
                        <span class="text-red-600"><i class="fa-solid fa-user-xmark mr-1"></i> Alpa: <strong id="count-alpa">0</strong></span>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-100 text-gray-600 text-xs uppercase tracking-wider">
                                <th class="p-4 font-semibold">Nama Siswa</th>
                                <th class="p-4 font-semibold text-center">Kelas</th>
                                <th class="p-4 font-semibold text-center">Regu</th>
                                <th class="p-4 font-semibold text-center">Status Kehadiran</th>
                            </tr>
                        </thead>
                        <tbody id="absen-table-body" class="divide-y divide-gray-100 text-sm">
                            <!-- JS Generated -->
                        </tbody>
                    </table>
                </div>
                <div id="container-simpan-absen" class="p-4 bg-gray-50 border-t border-gray-100 flex justify-end">
                    <button onclick="simpanAbsen()" class="w-full sm:w-auto bg-pramuka-700 hover:bg-pramuka-800 text-white px-6 py-3 rounded-xl font-medium shadow-sm transition active:scale-95 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Simpan & Kirim Absensi</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- PENILAIAN TAB -->
        <section id="tab-nilai" class="tab-content hidden space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 space-y-4">
                <div>
                    <h2 class="text-xl font-bold text-gray-800">Penilaian Berdasarkan Materi</h2>
                    <p class="text-sm text-gray-500">Masukkan nama materi latihan terlebih dahulu untuk memulai penilaian.</p>
                </div>
                <div class="flex flex-col md:flex-row gap-3">
                    <input type="text" id="input-materi-uji" placeholder="Contoh: Tali-Temali / PBB / Semaphore" class="flex-grow px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-pramuka-600 text-sm">
                    <button onclick="mulaiPenilaianMateri()" class="bg-pramuka-700 hover:bg-pramuka-800 text-white px-6 py-3 rounded-xl font-medium shadow-sm transition flex items-center justify-center space-x-2 active:scale-95">
                        <i class="fa-solid fa-play"></i>
                        <span>Mulai Beri Nilai</span>
                    </button>
                </div>
            </div>

            <div id="section-tabel-nilai" class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hidden">
                <div class="p-6 bg-pramuka-50 border-b border-gray-100 space-y-3">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                        <div>
                            <span class="text-xs font-bold uppercase text-gray-500">Materi Aktif:</span>
                            <h3 id="display-nama-materi" class="text-lg font-bold text-pramuka-800"></h3>
                        </div>
                        <div class="text-left sm:text-left">
                            <span class="text-xs font-bold uppercase text-gray-500 block">Tanggal Input:</span>
                            <p id="display-tanggal-input" class="text-sm font-bold text-gray-700"></p>
                        </div>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-100 text-gray-600 text-xs uppercase tracking-wider">
                                <th class="p-4 font-semibold">Nama Siswa</th>
                                <th class="p-4 font-semibold text-center">Kelas</th>
                                <th class="p-4 font-semibold text-center">Regu</th>
                                <th class="p-4 font-semibold text-center">Nilai (A - E)</th>
                            </tr>
                        </thead>
                        <tbody id="nilai-table-body" class="divide-y divide-gray-100 text-sm">
                            <!-- JS Generated -->
                        </tbody>
                    </table>
                </div>

                <div id="container-simpan-nilai" class="p-4 bg-gray-50 border-t border-gray-100 flex justify-end">
                    <button onclick="simpanDataNilai()" class="w-full sm:w-auto bg-pramuka-700 hover:bg-pramuka-800 text-white px-6 py-3 rounded-xl font-medium shadow-sm transition active:scale-95 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-floppy-disk"></i>
