    <script>
        let spreadsheetId = "1Xw-_rPopukH0bWP5BF959A_oNE-3OsvctuMHYLMjPD8";
        let appsScriptUrl = localStorage.getItem('pramuka_apps_script_url') || "https://script.google.com/macros/s/AKfycbwhrS4RqQAXIgNGJEUx65KboQySM2AYlMARopDGqrW7MEt1md-LgwVDm6x0DNFrZuZDbg/exec";
        
        let siswaList = JSON.parse(localStorage.getItem('pramuka_app_siswa')) || [];
        let pertemuanList = JSON.parse(localStorage.getItem('pramuka_app_pertemuan')) || [];
        let rekapNilaiList = JSON.parse(localStorage.getItem('pramuka_app_rekap_nilai')) || [];
        let hasilSheetList = [];
        let userRole = localStorage.getItem('pramuka_user_role') || 'tamu'; 
        let settingsUnlocked = false; 

        let activeClasses = JSON.parse(localStorage.getItem('pramuka_active_classes')) || ["Kelas 3", "Kelas 4", "Kelas 5", "Kelas 6"];

        function checkRole() {
            applyRoleUI();
            setDynamicGreeting();
        }

        function setDynamicGreeting() {
            const greetingEl = document.getElementById('current-greeting');
            const hour = new Date().getHours();
            let timeGreeting = "Halo, Kakak/Adik!";
            
            if (hour >= 3 && hour < 11) {
                timeGreeting = "Selamat Pagi, Kakak/Adik!";
            } else if (hour >= 11 && hour < 15) {
                timeGreeting = "Selamat Siang, Kakak/Adik!";
            } else if (hour >= 15 && hour < 18) {
                timeGreeting = "Selamat Sore, Kakak/Adik!";
            } else {
                timeGreeting = "Selamat Malam, Kakak/Adik!";
            }

            if(userRole === 'pembina') {
                greetingEl.textContent = "Halo, Kak Pembina!";
            } else {
                greetingEl.textContent = timeGreeting;
            }
        }

        function handleAuthClick() {
            if(userRole === 'pembina') {
                userRole = 'tamu';
                settingsUnlocked = false;
                localStorage.setItem('pramuka_user_role', 'tamu');
                applyRoleUI();
                showToast('Berhasil keluar dari Mode Pembina (Kembali ke Tamu)', 'info');
                const activeTab = document.querySelector('.tab-content:not(.hidden)').id;
                if(activeTab === 'tab-absen' || activeTab === 'tab-nilai' || activeTab === 'tab-settings') {
                    switchTab('dashboard');
                }
            } else {
                document.getElementById('login-modal-title').textContent = "Login Pembina";
                document.getElementById('login-modal-desc').textContent = "Masukkan password khusus pembina untuk mengakses fitur ubah dan simpan data.";
                document.getElementById('input-password').value = '';
                document.getElementById('login-modal').classList.remove('hidden');
                document.getElementById('login-modal').classList.add('flex');
                document.getElementById('input-password').focus();
                window.pendingLoginTarget = 'general';
            }
        }

        function closeLoginModal() {
            document.getElementById('login-modal').classList.add('hidden');
            document.getElementById('login-modal').classList.remove('flex');
            window.pendingLoginTarget = null;
        }

        function verifyLogin() {
            const pass = document.getElementById('input-password').value;
            if (window.pendingLoginTarget === 'settings') {
                if (pass === '123') {
                    settingsUnlocked = true;
                    closeLoginModal();
                    showToast('Pengaturan dibuka!', 'success');
                    document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
                    document.getElementById('tab-settings').classList.remove('hidden');
                    document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('bg-pramuka-800'));
                    const activeBtn = document.getElementById('nav-btn-settings');
                    if(activeBtn) activeBtn.classList.add('bg-pramuka-800');
                    initClassCheckboxes();
                } else {
                    showToast('Kode salah, Coba lagi!', 'error');
                    document.getElementById('input-password').value = '';
                    document.getElementById('input-password').focus();
                }
            } else {
                if(pass === '3132') {
                    userRole = 'pembina';
                    localStorage.setItem('pramuka_user_role', 'pembina');
                    closeLoginModal();
                    applyRoleUI();
                    showToast('Login berhasil! Masuk ke Mode Pembina.', 'success');
                    if(!document.getElementById('section-tabel-absen').classList.contains('hidden')) mulaiAbsen();
                    if(!document.getElementById('section-tabel-nilai').classList.contains('hidden')) mulaiPenilaianMateri();
                } else {
                    showToast('Password salah! Silakan coba lagi.', 'error');
                    document.getElementById('input-password').value = '';
                    document.getElementById('input-password').focus();
                }
            }
        }

        function applyRoleUI() {
            const btnText = document.getElementById('btn-mode-text');
            const authIcon = document.getElementById('auth-icon');
            const authBtn = document.getElementById('auth-action-btn');
            
            const dBtnText = document.getElementById('desktop-btn-mode-text');
            const dAuthIcon = document.getElementById('desktop-auth-icon');
            const dAuthBtn = document.getElementById('desktop-auth-btn');

            const pembinaElements = document.querySelectorAll('.nav-pembina-only, .quick-pembina-only');

            setDynamicGreeting();

            if(userRole === 'pembina') {
                btnText.textContent = "Logout Pembina";
                authIcon.className = "fa-solid fa-right-from-bracket w-4 text-xs text-red-200";
                authBtn.className = "w-full text-left px-2.5 py-2 rounded-lg text-xs font-semibold bg-red-600 text-white hover:bg-red-700 flex items-center space-x-2 transition";

                dBtnText.textContent = "Logout Pembina";
                dAuthIcon.className = "fa-solid fa-right-from-bracket text-xs";
                dAuthBtn.className = "ml-2 bg-red-600 hover:bg-red-700 text-white px-2 py-1.5 rounded-lg text-xs font-bold shadow-sm transition flex items-center space-x-1.5 active:scale-95";

                pembinaElements.forEach(el => el.style.display = 'flex');
            } else {
                btnText.textContent = "Login Pembina";
                authIcon.className = "fa-solid fa-right-to-bracket w-4 text-xs";
                authBtn.className = "w-full text-left px-2.5 py-2 rounded-lg text-xs font-semibold bg-amber-500 text-gray-900 hover:bg-amber-600 flex items-center space-x-2 transition";

                dBtnText.textContent = "Login Pembina";
                dAuthIcon.className = "fa-solid fa-right-to-bracket text-xs";
                dAuthBtn.className = "ml-2 bg-amber-500 hover:bg-amber-600 text-gray-900 px-2 py-1.5 rounded-lg text-xs font-bold shadow-sm transition flex items-center space-x-1.5 active:scale-95";

                pembinaElements.forEach(el => el.style.display = 'none');
            }
        }

        function initClassCheckboxes() {
            const checkboxes = document.querySelectorAll('.class-filter-cb');
            checkboxes.forEach(cb => {
                cb.checked = activeClasses.includes(cb.value);
            });
            document.getElementById('input-apps-script-url').value = appsScriptUrl;
        }

        function saveClassFilters() {
            const checkboxes = document.querySelectorAll('.class-filter-cb');
            activeClasses = [];
            checkboxes.forEach(cb => {
                if(cb.checked) activeClasses.push(cb.value);
            });
            localStorage.setItem('pramuka_active_classes', JSON.stringify(activeClasses));
            
            if(appsScriptUrl) {
                sendDataToAppsScript([{
                    sheet: 'Pengaturan',
                    values: ['activeClasses', JSON.stringify(activeClasses)]
                }], 'Filter kelas aktif berhasil disinkronkan ke Spreadsheet!');
            } else {
                updateDashboard();
                renderSiswa();
                renderRekapKehadiran();
                showToast('Filter kelas berhasil diperbarui!');
            }
        }

        function getFilteredSiswaList() {
            return siswaList.filter(s => activeClasses.includes(s.kelas));
        }

        function getNextSaturday() {
            let d = new Date();
            let day = d.getDay();
            let diff = (6 - day + 7) % 7;
            d.setDate(d.getDate() + diff);
            return d;
        }
        document.getElementById('tanggal-sabtu').valueAsDate = getNextSaturday();

        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        function toggleMobileMenu() {
            mobileMenu.classList.add('hidden');
        }

        function switchTab(tabId) {
            if(userRole === 'tamu' && (tabId === 'absen' || tabId === 'nilai')) {
                showToast('Menu ini khusus untuk Pembina. Silakan login terlebih dahulu.', 'warning');
                return;
            }

            if(tabId === 'settings' && !settingsUnlocked) {
                document.getElementById('login-modal-title').textContent = "Masukkan Kode Admin";
                document.getElementById('login-modal-desc').textContent = "Masukkan Kode Admin untuk mengakses pengaturan pembina.";
                document.getElementById('input-password').value = '';
                document.getElementById('login-modal').classList.remove('hidden');
                document.getElementById('login-modal').classList.add('flex');
                document.getElementById('input-password').focus();
                window.pendingLoginTarget = 'settings';
                return;
            }

            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('bg-pramuka-800'));
            
            const activeBtn = document.getElementById(`nav-btn-${tabId}`);
            if(activeBtn) {
                activeBtn.classList.add('bg-pramuka-800');
            }

            if(tabId === 'dashboard') updateDashboard();
            if(tabId === 'siswa') renderSiswa();
            if(tabId === 'rekap-nilai') renderRekapNilai();
            if(tabId === 'rekap') renderRekapKehadiran();
            if(tabId === 'hasil') renderHasil();
            if(tabId === 'settings') initClassCheckboxes();
        }

        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const msg = document.getElementById('toast-message');
            const icon = document.getElementById('toast-icon');

            msg.textContent = message;
