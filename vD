        function simpanAbsen() {
            if(userRole === 'tamu') {
                showToast('Mode Tamu tidak diizinkan menyimpan perubahan.', 'warning');
                return;
            }

            const tglInput = document.getElementById('tanggal-sabtu').value;
            if(!tglInput) {
                showToast('Mohon pilih tanggal kegiatan!', 'warning');
                return;
            }

            if(!pertemuanList.includes(tglInput)) {
                pertemuanList.push(tglInput);
                localStorage.setItem('pramuka_app_pertemuan', JSON.stringify(pertemuanList));
            }

            let exportRows = [`Nama Siswa\tKelas\tRegu\tTotal Hadir\tTotal Sakit/Izin\tTotal Alpa`];
            let payloadRows = [];
            const filteredSiswa = getFilteredSiswaList();

            siswaList.forEach(s => {
                s.hadirCount = 0;
                s.sakitCount = 0;
                s.alpaCount = 0;
                if(s.riwayatAbsen) {
                    for(let tgl in s.riwayatAbsen) {
                        let st = s.riwayatAbsen[tgl];
                        if(st === 'Hadir') s.hadirCount++;
                        else if(st === 'Sakit/Izin') s.sakitCount++;
                        else if(st === 'Alpa') s.alpaCount++;
                    }
                }
            });

            filteredSiswa.forEach(s => {
                let st = s.absen || 'Hadir';
                if(!s.riwayatAbsen) s.riwayatAbsen = {};
                s.riwayatAbsen[tglInput] = st;

                if(st === 'Hadir') s.hadirCount = (s.hadirCount || 0) + 1;
                else if(st === 'Sakit/Izin') s.sakitCount = (s.sakitCount || 0) + 1;
                else if(st === 'Alpa') s.alpaCount = (s.alpaCount || 0) + 1;

                exportRows.push(`${s.nama}\t${s.kelas}\t${s.regu}\t${s.hadirCount}\t${s.sakitCount}\t${s.alpaCount}`);
                payloadRows.push({
                    sheet: 'Rekap Absensi',
                    values: [s.nama, s.kelas, s.regu, s.hadirCount, s.sakitCount, s.alpaCount]
                });
            });

            localStorage.setItem('pramuka_app_siswa', JSON.stringify(siswaList));
            updateDashboard();
            renderRekapKehadiran();

            if(appsScriptUrl) {
                sendDataToAppsScript(payloadRows, 'Rekap absensi berhasil diperbarui dan dikirim otomatis ke Spreadsheet!');
            } else {
                showToast('Absensi berhasil disimpan!');
                showExportModal(exportRows.join('\n'));
            }
        }

