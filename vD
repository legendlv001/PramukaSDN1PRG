        function calculateFinalScore(siswa) {
            let totalMeetings = Math.max(pertemuanList.length, (siswa.hadirCount || 0) + (siswa.sakitCount || 0) + (siswa.alpaCount || 0), 1);
            let hadir = siswa.hadirCount || 0;
            let sakit = siswa.sakitCount || 0;
            let alpa = siswa.alpaCount || 0;
            
            let attendanceScore = Math.min(100, Math.round(((hadir * 100) + (sakit * 50) + (alpa * 0)) / totalMeetings));

            let gradeMapNum = { 'A': 100, 'B': 80, 'C': 70, 'D': 60, 'E': 50 };
            let riwayat = siswa.riwayatNilai || {};
            let grades = Object.values(riwayat);
            let avgGradeScore = 85;
            if(grades.length > 0) {
                let sum = 0;
                grades.forEach(g => {
                    sum += gradeMapNum[String(g).toUpperCase()] || 85;
                });
                avgGradeScore = Math.round(sum / grades.length);
            } else {
                avgGradeScore = gradeMapNum[String(siswa.nilai || 'A').toUpperCase()] || 85;
            }

            let finalScore = Math.round((0.7 * attendanceScore) + (0.3 * avgGradeScore));
            return finalScore;
        }

