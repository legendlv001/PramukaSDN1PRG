        function calculateAverageGrade(gradesArray) {
            if(!gradesArray || gradesArray.length === 0) return 'A';
            const gradeMap = { 'A': 5, 'B': 4, 'C': 3, 'D': 2, 'E': 1 };
            const revMap = { 5: 'A', 4: 'B', 3: 'C', 2: 'D', 1: 'E' };
            
            let sum = 0;
            let count = 0;
            gradesArray.forEach(g => {
                let score = gradeMap[String(g).toUpperCase()] || 5;
                sum += score;
                count++;
            });
            let avg = Math.round(sum / count);
            return revMap[avg] || 'A';
        }

